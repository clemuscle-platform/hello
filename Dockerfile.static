# syntax=docker/dockerfile:1.7
# Image du type « static » (site statique servi par nginx non privilégié, port 8080).
# Utilisée quand platform.yaml déclare « kind: static ».
FROM nginxinc/nginx-unprivileged:1.30.2-alpine
ARG APP_VERSION=dev
LABEL org.opencontainers.image.version="${APP_VERSION}"
# Correctifs de sécurité des paquets Alpine de l'image de base.
USER root
RUN apk upgrade --no-cache
COPY static/nginx.conf /etc/nginx/conf.d/default.conf
COPY static/site/ /usr/share/nginx/html/
USER 101
EXPOSE 8080
